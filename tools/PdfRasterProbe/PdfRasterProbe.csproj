<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <OutputPath>bin\</OutputPath>
    <AssemblyName>PdfRasterProbe</AssemblyName>
    <RootNamespace>PdfRasterProbe</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="Google.Apis.Gmail.v1">
      <HintPath>..\..\bin\Google.Apis.Gmail.v1.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="PDFtoImage">
      <HintPath>packages\PDFtoImage.5.4.0\lib\net471\PDFtoImage.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>packages\SkiaSharp.4.150.1\lib\net48\SkiaSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RecepcionDocumental">
      <HintPath>..\..\bin\RecepcionDocumental.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ProductFlowProbe.cs" />
    <Compile Include="GmailMimeProbe.cs" />
    <None Include="App.config" />
    <None Include="..\..\bin\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\bin\x64\*.dll">
      <Link>x64\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\App_Data\Tessdata\spa.traineddata">
      <Link>App_Data\Tessdata\spa.traineddata</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <Import Project="packages\SkiaSharp.NativeAssets.Win32.4.150.1\build\net48\SkiaSharp.NativeAssets.Win32.targets" />
  <Import Project="packages\bblanchon.PDFium.Win32.152.0.7961\build\net461\bblanchon.PDFium.Win32.targets" />
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
